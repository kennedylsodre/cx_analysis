	partition d_calendar = m
		mode: import
		queryGroup: dimensoes
		source =
				let
				    // Período do calendário: da data mais antiga à mais recente da consulta fato_tickets
				    DataInicio = Date.From(List.Min(f_tickets[ticket_date])),
				    DataFim = Date.From(List.Max(f_tickets[ticket_date])),
				
				    Datas = List.Dates(
				        DataInicio,
				        Duration.Days(DataFim - DataInicio) + 1,
				        #duration(1, 0, 0, 0)
				    ),
				
				    Tabela = Table.FromList(Datas, Splitter.SplitByNothing(), type table [Data = date]),
				
				    Calendario = Table.AddColumn(Tabela, "Info", each
				        let
				            d = [Data],
				            NumDia = Date.DayOfWeek(d, Day.Monday) + 1
				        in
				            [
				                Ano = Date.Year(d),
				                Trimestre = "T" & Text.From(Date.QuarterOfYear(d)),
				                MesNum = Date.Month(d),
				                Mes = Text.Proper(Date.ToText(d, [Format = "MMMM", Culture = "pt-BR"])),
				                MesAbrev = Text.Proper(Date.ToText(d, [Format = "MMM", Culture = "pt-BR"])),
				                AnoMes = Date.ToText(d, [Format = "yyyy-MM"]),
				                AnoMesNum = Date.Year(d) * 100 + Date.Month(d),
				                InicioMes = Date.StartOfMonth(d),
				                Semana = Date.WeekOfYear(d, Day.Monday),
				                InicioSemana = Date.StartOfWeek(d, Day.Monday),
				                Dia = Date.Day(d),
				                DiaSemanaNum = NumDia,
				                DiaSemana = Text.Proper(Date.ToText(d, [Format = "dddd", Culture = "pt-BR"])),
				                DiaUtil = NumDia <= 5
				            ]
				    ),
				
				    Expandido = Table.ExpandRecordColumn(
				        Calendario,
				        "Info",
				        {"Ano", "Trimestre", "MesNum", "Mes", "MesAbrev", "AnoMes", "AnoMesNum",
				         "InicioMes", "Semana", "InicioSemana", "Dia", "DiaSemanaNum", "DiaSemana", "DiaUtil"}
				    ),
				
				    Tipado = Table.TransformColumnTypes(Expandido, {
				        {"Ano", Int64.Type}, {"Trimestre", type text}, {"MesNum", Int64.Type},
				        {"Mes", type text}, {"MesAbrev", type text}, {"AnoMes", type text},
				        {"AnoMesNum", Int64.Type}, {"InicioMes", type date}, {"Semana", Int64.Type},
				        {"InicioSemana", type date}, {"Dia", Int64.Type}, {"DiaSemanaNum", Int64.Type},
				        {"DiaSemana", type text}, {"DiaUtil", type logical}
				    })
				in
				    Tipado

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

